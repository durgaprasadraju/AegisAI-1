# Base Dockerfile for AegisAI services
# This can be used as a base image for all services

FROM golang:1.21-alpine AS base

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git make

# Copy go mod files if using a root go.mod
# COPY go.mod go.sum ./
# RUN go mod download

# This base image can be extended by service-specific Dockerfiles
